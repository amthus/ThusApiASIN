# Copier vers .env (jamais commité). Voir README.
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Si POSTGRES_DB est absent, SQLite est utilisé (démarrage rapide / recette).
POSTGRES_DB=demandes
POSTGRES_USER=demandes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# 1 derrière un proxy HTTPS (active redirection SSL + HSTS)
DJANGO_HTTPS=0
